{
  "manifest_version": 3,
  "name": "TV Alert Extender",
  "version": "0.1.0",
  "description": "Автоматически продлевает истекающие алерты TradingView через внутренний API.",

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "https://www.tradingview.com/*",
    "https://pricealerts.tradingview.com/*"
  ],

  "background": {
    "scripts": ["config.js", "background.js"]
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "TV Alert Extender"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "tv-alert-extender@example.local",
      "strict_min_version": "128.0"
    }
  }
}
